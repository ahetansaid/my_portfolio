# ─── Base de données PostgreSQL (Neon) ───────────────────────────────────────
# Récupérer depuis https://console.neon.tech après création du projet
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/portfolio?sslmode=require"

# ─── Authentification admin ──────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
JWT_SECRET="change-moi-avec-une-chaine-aleatoire-longue-et-complexe"

# ─── OpenAI (IA match recruteur + scoring Career Radar) ──────────────────────
OPENAI_API_KEY="sk-proj-..."

# ─── Career Radar (module opportunités) ──────────────────────────────────────
# Secret partagé pour déclencher l'ingestion depuis un cron externe (cron-job.org, etc.)
# POST /api/radar/ingest avec header  x-radar-secret: <valeur>
RADAR_CRON_SECRET="change-moi"
# Notifications email (Resend — https://resend.com). Requis pour les alertes d'opportunités.
RESEND_API_KEY="re_..."
RADAR_NOTIFY_EMAIL="saidahetan@gmail.com"

# ─── Site (pour SEO, sitemap, metadata) ──────────────────────────────────────
# En prod Vercel : https://ton-domaine.vercel.app ou ton domaine custom
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
