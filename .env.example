# ─── Base de données PostgreSQL (Neon) ───────────────────────────────────────
# Récupérer depuis https://console.neon.tech après création du projet
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/portfolio?sslmode=require"

# ─── Authentification admin ──────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
JWT_SECRET="change-moi-avec-une-chaine-aleatoire-longue-et-complexe"

# ─── OpenAI (IA match recruteur + repli scoring Career Radar) ────────────────
OPENAI_API_KEY="sk-proj-..."

# ─── Anthropic Claude (moteur de scoring Career Radar — prioritaire) ─────────
# Si présente, le radar utilise Claude ; sinon il retombe sur OpenAI.
ANTHROPIC_API_KEY="sk-ant-..."
# Modèle Claude (optionnel). Défaut : claude-opus-4-8. Pour réduire le coût : claude-haiku-4-5
ANTHROPIC_MODEL="claude-opus-4-8"

# ─── Career Radar (module opportunités) ──────────────────────────────────────
# Secret partagé pour déclencher l'ingestion depuis un cron externe (cron-job.org, etc.)
# POST /api/radar/ingest avec header  x-radar-secret: <valeur>
RADAR_CRON_SECRET="change-moi"
# Notifications email (SMTP — ex. Gmail avec un mot de passe d'application).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ton-compte@gmail.com"
SMTP_PASS="mot-de-passe-application-google"
EMAIL_FROM="ton-compte@gmail.com"
# Adresse qui reçoit les alertes d'opportunités
RADAR_NOTIFY_EMAIL="saidahetan@gmail.com"

# ─── Site (pour SEO, sitemap, metadata) ──────────────────────────────────────
# En prod Vercel : https://ton-domaine.vercel.app ou ton domaine custom
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
